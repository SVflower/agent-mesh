{
  "name": "agent-mesh",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Mesh 是一个面向本地 Agent Runtime 的协作控制平面。",
  "type": "module",
  "packageManager": "pnpm@8.6.5",
  "scripts": {
    "build": "pnpm -r build",
    "dev:desktop": "pnpm --filter @agent-mesh/desktop dev:tauri",
    "dev:mcp": "pnpm --filter @agent-mesh/mcp-server dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
